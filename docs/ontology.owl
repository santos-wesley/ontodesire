        <rdf:type rdf:resource="https://w3id.org/ontodesire#CharacteristicMark"/>
        <rdfs:label xml:lang="en">disposition to have attention drawn to reasons in favour of p</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontodesire#RewardLearningDrive -->


