        <rdfs:label xml:lang="en">Nora drinks a cup of tea soon</rdfs:label>
        <skos:scopeNote xml:lang="en">The disambiguation among possessing/drinking and soon/someday is what motivates treating desires as propositional attitudes.</skos:scopeNote>
    </owl:NamedIndividual>
    


