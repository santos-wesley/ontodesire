        <answersObjection rdf:resource="https://w3id.org/ontodesire#DoubleFaultObjection"/>
        <belongsToFamily rdf:resource="https://w3id.org/ontodesire#ActionBasedFamily"/>
        <defendedBy rdf:resource="https://w3id.org/ontodesire#DavidPapineau"/>
