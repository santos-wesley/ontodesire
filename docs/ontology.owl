        <rdf:type rdf:resource="https://w3id.org/ontodesire#CharacteristicMark"/>
        <rdfs:label xml:lang="en">use of representations of p to drive reward-based learning</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontodesire#RewardLearningTheory -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontodesire#RewardLearningTheory">
        <rdf:type rdf:resource="https://w3id.org/ontodesire#MonofactorialTheory"/>
        <anticipatedBy rdf:resource="https://w3id.org/ontodesire#FredDretske"/>
        <belongsToFamily rdf:resource="https://w3id.org/ontodesire#LearningBasedFamily"/>
        <defendedBy rdf:resource="https://w3id.org/ontodesire#TimothySchroeder"/>
        <identifiesDesireWith rdf:resource="https://w3id.org/ontodesire#RewardLearningDrive"/>
        <impliesCategory rdf:resource="https://w3id.org/ontodesire#LearningMechanismCategory"/>
        <locatesDesireIn rdf:resource="https://w3id.org/ontodesire#DopaminergicRewardSystem"/>
        <suffersObjection rdf:resource="https://w3id.org/ontodesire#AprioriImplausibilityObjection"/>
        <rdfs:label xml:lang="en">reward-learning theory</rdfs:label>
        <skos:definition xml:lang="en">To desire p is to use representations of p to drive reward-based learning.</skos:definition>
        <skos:note xml:lang="en">Treats desire as a natural kind; the least a priori credible of the listed theories.</skos:note>
    </owl:NamedIndividual>
    


