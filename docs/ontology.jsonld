  "@id" : "http://www.w3.org/2004/02/skos/core#altLabel",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#definition",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#note",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#scopeNote",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://xmlns.com/foaf/0.1/Person",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
  "@id" : "http://xmlns.com/foaf/0.1/name",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "https://w3id.org/ontodesire",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "A reference ontology of desire that reifies rival philosophical theories of desire as first-class entities, keeping the Desire class deliberately underdetermined. Includes characteristic marks, objections, the four orthogonal partitions of desire, per-theory categorial stances, and bibliographic anchoring."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://plato.stanford.edu/entries/desire/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "OntoDesire"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "For declaring commitments only, import <https://w3id.org/ontodesire/commitments> alone."
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "https://w3id.org/ontodesire/commitments"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/ontodesire/0.3.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "0.3.0"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#ActionBasedFamily",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#ActionDisposition",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#CharacteristicMark"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "disposition to take the actions one believes conducive to p"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#ActionProductionFunction",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#CharacteristicMark"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "having the (biological) function of producing action"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#AgnieszkaJaworska",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Philosopher"
  } ],
  "http://xmlns.com/foaf/0.1/name" : [ {
    "@value" : "Agnieszka Jaworska"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#AlexGregory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Philosopher"
  } ],
  "http://xmlns.com/foaf/0.1/name" : [ {
    "@value" : "Alex Gregory"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#AnimalObjection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Objection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "non-human animal objection"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Rats seem to desire without representing anything as good; if desire does not require representing the good in them, why in us?"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#AppearanceOfGood",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "appearance of good"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#MentalState"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "High-level perceptual state, distinct from the judgment that something is good (Stampe 1987; Oddie 2005)."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#AprioriImplausibilityObjection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Objection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "a priori implausibility objection"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The theory admits desire in a creature incapable of acting or feeling, provided it represents and learns appropriately."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#AssociativeLearningAcquisition",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#OriginMechanism"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "acquisition via reward-based associative learning"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "States of affairs that presage the satisfaction of existing intrinsic desires become intrinsically desired themselves."
  } ],
  "https://w3id.org/ontodesire#defendedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#TimothySchroeder"
  } ],
  "https://w3id.org/ontodesire#generates" : [ {
    "@id" : "https://w3id.org/ontodesire#IntrinsicDesire"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#AttentionBasedFamily",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#Bearer",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "bearer"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An agent -- an organism or an artificial system -- capable of instantiating mental states. Restricting bearers to organisms would itself be a theoretical commitment, negated by the BDI agent-modelling use cases that motivate this resource."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#BehavioralTicObjection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Objection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "behavioral tic objection"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The theory is too permissive: one who tends to stutter would count as desiring to stutter."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#Belief",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "belief"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#MentalState"
  }, {
    "@id" : "_:genid2"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#BeliefInTheGood",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "belief in the good"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#Belief"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#Besire",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "besire"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#MentalState"
  }, {
    "@id" : "_:genid3"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Hybrid state posited as having both belief-like and desire-like directions of fit."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#BiologicalFunctionCategory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#Caring",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "caring"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#ProAttitude"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Jaworska: a package of motivation, affect, attention and emotion directed at someone's welfare; readable as a holistic theory of a subclass of desires."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#CaringTheory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#HolisticTheory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "caring theory"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Not intended as a theory of desire, but readable as a holistic theory of the subclass of desires that constitute caring."
  } ],
  "https://w3id.org/ontodesire#belongsToFamily" : [ {
    "@id" : "https://w3id.org/ontodesire#HolisticFamily"
  } ],
  "https://w3id.org/ontodesire#defendedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#AgnieszkaJaworska"
  } ],
  "https://w3id.org/ontodesire#identifiesDesireWith" : [ {
    "@id" : "https://w3id.org/ontodesire#ActionDisposition"
  }, {
    "@id" : "https://w3id.org/ontodesire#PleasureDisposition"
  }, {
    "@id" : "https://w3id.org/ontodesire#ReasonsAttention"
  } ],
  "https://w3id.org/ontodesire#impliesCategory" : [ {
    "@id" : "https://w3id.org/ontodesire#CausalRoleStateCategory"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#CarolynMorillo",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Philosopher"
  } ],
  "http://xmlns.com/foaf/0.1/name" : [ {
    "@value" : "Carolyn Morillo"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#CategorialStance",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
  "@id" : "https://w3id.org/ontodesire#CausalPriorityObjection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Objection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "causal priority of desire over pleasure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "If desire satisfaction is the standard cause of pleasure, desire and pleasure are ontologically distinct as cause and effect."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#CausalRoleStateCategory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#CharacteristicMark",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "characteristic mark of desire"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An effect or disposition typically associated with desire. Each monofactorial theory elects exactly one as essential and treats the rest as contingent accompaniments."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#ConditionalDesire",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "conditional desire"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#Desire"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Hard case for content specification (McDaniel and Bradley 2008)."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#Content",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "intentional content"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#Craving",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "craving"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#ProAttitude"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#DavidLewis",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Philosopher"
  } ],
  "http://xmlns.com/foaf/0.1/name" : [ {
    "@value" : "David Lewis"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#DavidPapineau",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Philosopher"
  } ],
  "http://xmlns.com/foaf/0.1/name" : [ {
    "@value" : "David Papineau"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#DavidsonianInterpretationism",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#HolisticTheory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Davidsonian interpretationism"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Desires as states of the whole organism, existing in virtue of interpretability."
  } ],
  "https://w3id.org/ontodesire#belongsToFamily" : [ {
    "@id" : "https://w3id.org/ontodesire#HolisticFamily"
  } ],
  "https://w3id.org/ontodesire#defendedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#DonaldDavidson"
  } ],
  "https://w3id.org/ontodesire#identifiesDesireWith" : [ {
    "@id" : "https://w3id.org/ontodesire#ActionDisposition"
  }, {
    "@id" : "https://w3id.org/ontodesire#GoodBeliefDisposition"
  }, {
    "@id" : "https://w3id.org/ontodesire#PleasureDisposition"
  }, {
    "@id" : "https://w3id.org/ontodesire#ReasonsAttention"
  } ],
  "https://w3id.org/ontodesire#impliesCategory" : [ {
    "@id" : "https://w3id.org/ontodesire#CausalRoleStateCategory"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#DennisStampe",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Philosopher"
  } ],
  "http://xmlns.com/foaf/0.1/name" : [ {
    "@value" : "Dennis Stampe"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#Desire",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "desire"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#ProAttitude"
  }, {
    "@id" : "_:genid7"
  }, {
    "@id" : "_:genid8"
  }, {
    "@id" : "_:genid9"
  }, {
    "@id" : "_:genid10"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid4"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A conative mental state whose content specifies a satisfaction condition to be realized in the world. Deliberately underdetermined: the essential nature of desire is what the reified theories in this ontology disagree about."
  } ],
  "https://w3id.org/ontodesire#commitsToStructuralStance" : [ {
    "@id" : "https://w3id.org/ontodesire#SingleBearer"
  }, {
    "@id" : "https://w3id.org/ontodesire#StandingDesiresGenuine"
  }, {
    "@id" : "https://w3id.org/ontodesire#UniversalWorldToMindFit"
  } ],
  "https://w3id.org/ontodesire#deliberatelyUncommittedOn" : [ {
    "@id" : "https://w3id.org/ontodesire#FamilyAxis"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#DesireAsBeliefInGood",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#MonofactorialTheory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "desire as belief in the good"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "To desire p is to believe that p is good (or, in the contemporary variant, that one has normative reason to bring p about)."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "The attribution to Socrates is a classical antecedent (the Socratic thesis that we desire the good), not a formulation of the analysis; the analysis is actively defended in the contemporary literature (Gregory, Desire as Belief, OUP 2021)."
  } ],
  "https://w3id.org/ontodesire#attributedTo" : [ {
    "@id" : "https://w3id.org/ontodesire#Socrates"
  } ],
  "https://w3id.org/ontodesire#belongsToFamily" : [ {
    "@id" : "https://w3id.org/ontodesire#GoodBasedFamily"
  } ],
  "https://w3id.org/ontodesire#defendedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#AlexGregory"
  } ],
