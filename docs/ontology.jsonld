  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontodesire#ProAttitude"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is satisfied by"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontodesire#StateOfAffairs"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "For desires, satisfaction is the actual realization of the state of affairs, not the belief that it obtained."
  } ],
  "https://w3id.org/ontodesire#commitsToStructuralStance" : [ {
    "@id" : "https://w3id.org/ontodesire#SatisfactionByStatesOfAffairs"
  } ]
