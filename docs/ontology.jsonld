  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Nora"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#ObjectContent",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#ObjectContentItem",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "object (as content)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#Content"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Non-propositional content, posited by those who deny that all desires are propositional attitudes (Thagard 2006)."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#ObjectDesire",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "desire for an object"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#Desire"
  }, {
    "@id" : "_:genid24"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontodesire#StateOfAffairsDesire"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Minority view; faithful to ordinary talk and to animal desire."
  } ],
  "https://w3id.org/ontodesire#partitionedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#byContent"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#Objection",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "objection"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#OccurrentAffectiveEpisodeCategory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#OccurrentDesire",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "occurrent desire"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#Desire"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontodesire#StandingDesire"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A desire playing some role in the psyche at the moment — not necessarily in control of action, nor necessarily conscious."
  } ],
  "https://w3id.org/ontodesire#partitionedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#byManifestation"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#OccurrentFeelingCategory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#OriginMechanism",
