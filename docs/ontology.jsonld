}, {
  "@id" : "https://w3id.org/ontodesire#DesireAsPerceptionOfGood",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#MonofactorialTheory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "desire as perception of the good"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "To desire p is for p to appear good to the organism — a high-level perceptual state, distinct from judgment."
  } ],
  "https://w3id.org/ontodesire#answersObjection" : [ {
    "@id" : "https://w3id.org/ontodesire#LewisDecisionTheoreticObjection"
  } ],
  "https://w3id.org/ontodesire#belongsToFamily" : [ {
    "@id" : "https://w3id.org/ontodesire#GoodBasedFamily"
  } ],
  "https://w3id.org/ontodesire#defendedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#DennisStampe"
  }, {
    "@id" : "https://w3id.org/ontodesire#GrahamOddie"
  } ],
  "https://w3id.org/ontodesire#identifiesDesireWith" : [ {
    "@id" : "https://w3id.org/ontodesire#GoodAppearanceDisposition"
  } ],
  "https://w3id.org/ontodesire#impliesCategory" : [ {
    "@id" : "https://w3id.org/ontodesire#PerceptualStateCategory"
  } ],
  "https://w3id.org/ontodesire#suffersObjection" : [ {
    "@id" : "https://w3id.org/ontodesire#AnimalObjection"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#DesireStrength",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "desire strength"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A continuous magnitude, canonically characterized by causal power over the control of action; each theory of desire induces its own corresponding metric."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Puzzle: manifestations of strength fluctuate (mood, fatigue, temporal distance) without the strength itself seeming to vary — an advantage of holistic and learning-based theories, which do not reduce strength to a single observable."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#DirectedAttention",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#MonofactorialTheory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "directed-attention theory"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "To desire p is for the thought of p to keep occurring in a favourable light, with attention directed insistently toward considerations counting in favour of p."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Technically a sufficient condition rather than a full theory; fits occurrent desires best."
  } ],
  "https://w3id.org/ontodesire#belongsToFamily" : [ {
    "@id" : "https://w3id.org/ontodesire#AttentionBasedFamily"
  } ],
  "https://w3id.org/ontodesire#defendedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#TMScanlon"
  } ],
  "https://w3id.org/ontodesire#identifiesDesireWith" : [ {
    "@id" : "https://w3id.org/ontodesire#ReasonsAttention"
  } ],
  "https://w3id.org/ontodesire#impliesCategory" : [ {
    "@id" : "https://w3id.org/ontodesire#MentalProcessCategory"
  } ],
  "https://w3id.org/ontodesire#suffersObjection" : [ {
    "@id" : "https://w3id.org/ontodesire#NarrowAttentionObjection"
  } ]
}, {
