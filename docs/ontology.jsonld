  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontodesire#Philosopher"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#realizes",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#IrreflexiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontodesire#RealizerDesire"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "realizes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontodesire#IntrinsicDesire"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Distinct from isMeansTo: the realizer is an instance of the end, not a means of reaching it."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#strengthDegree",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
