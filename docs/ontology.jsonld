  "http://xmlns.com/foaf/0.1/name" : [ {
    "@value" : "John McDowell"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#LearningBasedFamily",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#LearningMechanismCategory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#LewisDecisionTheoreticObjection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Objection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Lewis's decision-theoretic objection"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The Desire-as-Belief thesis generates inconsistencies within decision theory, given the differences between rational belief revision and rational motivation revision."
  } ],
  "https://w3id.org/ontodesire#raisedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#DavidLewis"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#LewisianFunctionalism",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#HolisticTheory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Lewisian functionalism"
  } ],
  "https://w3id.org/ontodesire#belongsToFamily" : [ {
    "@id" : "https://w3id.org/ontodesire#HolisticFamily"
  } ],
  "https://w3id.org/ontodesire#defendedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#DavidLewis"
  } ],
  "https://w3id.org/ontodesire#identifiesDesireWith" : [ {
    "@id" : "https://w3id.org/ontodesire#ActionDisposition"
  }, {
    "@id" : "https://w3id.org/ontodesire#GoodBeliefDisposition"
  }, {
    "@id" : "https://w3id.org/ontodesire#InformationAttention"
  }, {
    "@id" : "https://w3id.org/ontodesire#PleasureDisposition"
  }, {
    "@id" : "https://w3id.org/ontodesire#ReasonsAttention"
  } ],
  "https://w3id.org/ontodesire#impliesCategory" : [ {
    "@id" : "https://w3id.org/ontodesire#CausalRoleStateCategory"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#MeansEndReasoning",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#OriginMechanism"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "means-end reasoning"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Largely uncontroversial; the derived desire's strength grows with the intrinsic desire's strength and the apparent usefulness of the means."
  } ],
  "https://w3id.org/ontodesire#generates" : [ {
    "@id" : "https://w3id.org/ontodesire#InstrumentalDesire"
  }, {
    "@id" : "https://w3id.org/ontodesire#RealizerDesire"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#MentalMomentCategory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#MentalProcessCategory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#MentalState",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "mental state"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#MerelyInstrumentalDesire",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "merely instrumental desire"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#InstrumentalDesire"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Desired only as a means, in no measure for its own sake. This is the usual reinforced sense of 'instrumental'."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#MichaelSmith",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Philosopher"
  } ],
  "http://xmlns.com/foaf/0.1/name" : [ {
    "@value" : "Michael Smith"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#MindToWorld",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#DirectionOfFit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "mind-to-world"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Analogous to the declarative sentence: satisfied if the state conforms to the world."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#MonofactorialTheory",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "monofactorial theory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#TheoryOfDesire"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid20"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Privileges exactly one characteristic mark as essential to desire."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#MotivatingGoodBeliefObjection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Objection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "motivating belief-in-good objection"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Judgments of what is good or obligatory also dispose to action; action-based theories fail to distinguish desire from goodness judgment."
  } ],
  "https://w3id.org/ontodesire#raisedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#JohnMcDowell"
  }, {
    "@id" : "https://w3id.org/ontodesire#TMScanlon"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#NarrowAttentionObjection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Objection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "narrow attentional focus objection"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Desire directs attention also to information about p, to opportunities to obtain it, and to those discussing p — not only to reasons in favour of p."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#NeuralRealizer",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "neural realizer"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#NonHumanAnimal",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "non-human animal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#Bearer"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Test case for good-based theories: the rat seems to desire escape from the cat without representing anything as good."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#Nora",
