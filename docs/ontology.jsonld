  "http://www.w3.org/2002/07/owl#annotatedProperty" : [ {
    "@id" : "https://w3id.org/ontodesire#commitsToStructuralStance"
  } ],
  "http://www.w3.org/2002/07/owl#annotatedSource" : [ {
    "@id" : "https://w3id.org/ontodesire#Desire"
  } ],
  "http://www.w3.org/2002/07/owl#annotatedTarget" : [ {
    "@id" : "https://w3id.org/ontodesire#SingleBearer"
  } ],
  "https://w3id.org/ontodesire#commitmentEvidence" : [ {
    "@value" : "Desire rdfs:subClassOf [ owl:onProperty hasBearer ; owl:cardinality 1 ] (this module, Section 12)."
  } ],
  "https://w3id.org/ontodesire#commitmentNote" : [ {
    "@value" : "Declared by OntoDesire itself. Excludes plural/shared subjects of one desire token; collective-conation theorists would contest it."
  } ]
}, {
  "@id" : "_:genid12",
  "@type" : [ "http://www.w3.org/2002/07/owl#Axiom" ],
  "http://www.w3.org/2002/07/owl#annotatedProperty" : [ {
    "@id" : "https://w3id.org/ontodesire#commitsToStructuralStance"
  } ],
  "http://www.w3.org/2002/07/owl#annotatedSource" : [ {
    "@id" : "https://w3id.org/ontodesire#Desire"
  } ],
  "http://www.w3.org/2002/07/owl#annotatedTarget" : [ {
    "@id" : "https://w3id.org/ontodesire#StandingDesiresGenuine"
  } ],
  "https://w3id.org/ontodesire#commitmentEvidence" : [ {
    "@value" : "Desire owl:equivalentClass [ owl:unionOf ( OccurrentDesire StandingDesire ) ] (this module, Section 3.3)."
  } ],
  "https://w3id.org/ontodesire#commitmentNote" : [ {
    "@value" : "Declared by OntoDesire itself. Some dispositionalists deny that standing desires are genuine desires, reading them as mere dispositions to generate occurrent ones (see the skos:note on StandingDesire)."
  } ]
}, {
  "@id" : "_:genid13",
  "@type" : [ "http://www.w3.org/2002/07/owl#Axiom" ],
  "http://www.w3.org/2002/07/owl#annotatedProperty" : [ {
    "@id" : "https://w3id.org/ontodesire#commitsToStructuralStance"
  } ],
  "http://www.w3.org/2002/07/owl#annotatedSource" : [ {
    "@id" : "https://w3id.org/ontodesire#Desire"
  } ],
  "http://www.w3.org/2002/07/owl#annotatedTarget" : [ {
    "@id" : "https://w3id.org/ontodesire#UniversalWorldToMindFit"
  } ],
  "https://w3id.org/ontodesire#commitmentEvidence" : [ {
    "@value" : "Desire rdfs:subClassOf [ owl:onProperty hasDirectionOfFit ; owl:hasValue WorldToMind ] (this module, Section 7). The axiom is universal, not exclusive: nothing caps hasDirectionOfFit, so a desire may consistently also bear mind-to-world fit."
  } ],
  "https://w3id.org/ontodesire#commitmentNote" : [ {
    "@value" : "Declared by OntoDesire itself. Retained deliberately: universal world-to-mind fit is the closest thing to common ground the debate has, but it is contested in the desire-as-belief debate that Lewis (1988) opened by attacking the thesis, by its contemporary defenders (Gregory 2021), and in the besire literature -- a commitment, not a neutral fact."
  } ]
}, {
  "@id" : "_:genid14",
  "@type" : [ "http://www.w3.org/2002/07/owl#Axiom" ],
  "http://www.w3.org/2002/07/owl#annotatedProperty" : [ {
    "@id" : "https://w3id.org/ontodesire#deliberatelyUncommittedOn"
  } ],
  "http://www.w3.org/2002/07/owl#annotatedSource" : [ {
    "@id" : "https://w3id.org/ontodesire#Desire"
  } ],
  "http://www.w3.org/2002/07/owl#annotatedTarget" : [ {
    "@id" : "https://w3id.org/ontodesire#FamilyAxis"
  } ],
  "https://w3id.org/ontodesire#commitmentEvidence" : [ {
    "@value" : "skos:definition of Desire: 'Deliberately underdetermined: the essential nature of desire is what the reified theories in this ontology disagree about.'"
  } ],
  "https://w3id.org/ontodesire#commitmentNote" : [ {
    "@value" : "The flagship design decision in machine-readable form: the essence-level axis is deliberately uncommitted -- the rival theories are reified, not adjudicated."
  } ]
