    "@id" : "https://w3id.org/ontodesire#SatisfactionByStatesOfAffairs"
  } ],
  "https://w3id.org/ontodesire#commitmentEvidence" : [ {
    "@value" : "isSatisfiedBy rdfs:range StateOfAffairs (this module, Section 10)."
  } ],
  "https://w3id.org/ontodesire#commitmentNote" : [ {
    "@value" : "Declared by OntoDesire itself: even object-desires are given state-of-affairs satisfiers -- structurally adjacent to the possession-rewrite the audit flags in SUMO, retained here because satisfaction conditions, unlike contents, are standardly worldly; object-desire theorists may contest it."
  } ]
}, {
