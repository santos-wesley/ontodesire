  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "locates desire in"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontodesire#NeuralRealizer"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#noraDrinksTeaSoon",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Proposition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Nora drinks a cup of tea soon"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The disambiguation among possessing/drinking and soon/someday is what motivates treating desires as propositional attitudes."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#noraTriesNewTeas",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#Proposition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Nora tries teas she has not tried before"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#norasDesireForTea",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#FirstOrderDesire"
  }, {
    "@id" : "https://w3id.org/ontodesire#OccurrentDesire"
  }, {
    "@id" : "https://w3id.org/ontodesire#StateOfAffairsDesire"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Nora's desire for tea"
  } ],
  "https://w3id.org/ontodesire#hasBearer" : [ {
    "@id" : "https://w3id.org/ontodesire#Nora"
  } ],
  "https://w3id.org/ontodesire#hasContent" : [ {
    "@id" : "https://w3id.org/ontodesire#noraDrinksTeaSoon"
  } ],
  "https://w3id.org/ontodesire#hasStrength" : [ {
    "@id" : "https://w3id.org/ontodesire#norasTeaDesireStrength"
  } ],
  "https://w3id.org/ontodesire#isSatisfiedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#noraDrinksTeaSoon"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#norasStandingDesireForNewTeas",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#IntrinsicDesire"
  }, {
    "@id" : "https://w3id.org/ontodesire#StandingDesire"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Nora's standing desire to try new teas"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Example of the explanatory role of standing desires: explains why the new tin captures her attention and why she is delighted. No strength individual is asserted: under v0.3.0's max-1 axiom a desire need not carry a determinate cardinal strength."
  } ],
  "https://w3id.org/ontodesire#hasBearer" : [ {
    "@id" : "https://w3id.org/ontodesire#Nora"
  } ],
  "https://w3id.org/ontodesire#hasContent" : [ {
    "@id" : "https://w3id.org/ontodesire#noraTriesNewTeas"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#norasTeaDesireStrength",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#DesireStrength"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#partitionedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "partitioned by"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Annotates a subclass of Desire with the orthogonal criterion that generates it, so that the four facets are not mistaken for a single tree."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#preferredTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#TransitiveProperty" ],
