  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#IntrinsicDesire",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "intrinsic desire"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#Desire"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontodesire#MerelyInstrumentalDesire"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A desire whose object is wanted at least partly for its own sake."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "NOT disjoint from InstrumentalDesire: the same desire can be partly for its own sake and partly as a means (Schroeder's father case)."
  } ],
  "https://w3id.org/ontodesire#partitionedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#byJustificatoryStructure"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#JohnMcDowell",
