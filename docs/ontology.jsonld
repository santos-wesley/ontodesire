    "@id" : "https://w3id.org/ontodesire#MonofactorialTheory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "reward-learning theory"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "To desire p is to use representations of p to drive reward-based learning."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Treats desire as a natural kind; the least a priori credible of the listed theories."
  } ],
