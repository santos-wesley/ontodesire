}, {
  "@id" : "https://w3id.org/ontodesire#HedonicDispositional",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#MonofactorialTheory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hedonic dispositional theory"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "To desire p is to be disposed to take pleasure in its seeming that p and displeasure in its seeming that not-p."
  } ],
  "https://w3id.org/ontodesire#belongsToFamily" : [ {
    "@id" : "https://w3id.org/ontodesire#PleasureBasedFamily"
  } ],
  "https://w3id.org/ontodesire#defendedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#GFSchueler"
  }, {
    "@id" : "https://w3id.org/ontodesire#GalenStrawson"
  } ],
  "https://w3id.org/ontodesire#identifiesDesireWith" : [ {
    "@id" : "https://w3id.org/ontodesire#PleasureDisposition"
  } ],
  "https://w3id.org/ontodesire#impliesCategory" : [ {
    "@id" : "https://w3id.org/ontodesire#OccurrentFeelingCategory"
  } ],
  "https://w3id.org/ontodesire#suffersObjection" : [ {
    "@id" : "https://w3id.org/ontodesire#CausalPriorityObjection"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#HedonicNeural",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#MonofactorialTheory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hedonic neural-identity theory"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Pleasure episodes are identical to reward-system activity, and that activity does the work of desire; so desires are pleasure episodes."
  } ],
  "https://w3id.org/ontodesire#belongsToFamily" : [ {
    "@id" : "https://w3id.org/ontodesire#PleasureBasedFamily"
  } ],
  "https://w3id.org/ontodesire#defendedBy" : [ {
