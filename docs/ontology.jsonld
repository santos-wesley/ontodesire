  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "origin mechanism"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#PartitionCriterion",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "partition criterion"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#PerceptualStateCategory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#Philosopher",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "philosopher"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://xmlns.com/foaf/0.1/Person"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#Pleasure",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "pleasure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#MentalState"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#PleasureBasedFamily",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#PleasureDisposition",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#CharacteristicMark"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "disposition to pleasure at its seeming that p, displeasure at its seeming that not-p"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Family-grain mark: the hedonic neural-identity theory reads it occurrently (desires ARE pleasure/reward episodes) rather than dispositionally, which is why the causal-priority objection targets only the dispositional variant. A dispositional/occurrent mark split, mirroring the good-based split, is a candidate refinement for the next version."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#Preference",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "preference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#ProAttitude"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#ProAttitude",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "pro attitude"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#MentalState"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The umbrella under which cognate conative states are grouped; whether they constitute one mental state or many is disputed."
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#Proposition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "proposition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#StateOfAffairs"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Subsuming propositions under states of affairs is a substantive simplification of the ontology of content (abstract truth-bearers vs. worldly truth-makers); it is declared below rather than made silently."
  } ],
  "https://w3id.org/ontodesire#commitsToStructuralStance" : [ {
    "@id" : "https://w3id.org/ontodesire#PropositionsAsStatesOfAffairs"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#PropositionsAsStatesOfAffairs",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/ontodesire#Purpose",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "purpose"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#ProAttitude"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#RationalityAcquisition",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#OriginMechanism"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "acquisition via reasoning about one's rationality"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Believing that, were one rational, one would desire p tends to generate an intrinsic desire for p; breaks with the Humean dictum that beliefs do not dictate intrinsic desire."
  } ],
  "https://w3id.org/ontodesire#defendedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#MichaelSmith"
  } ],
  "https://w3id.org/ontodesire#generates" : [ {
    "@id" : "https://w3id.org/ontodesire#IntrinsicDesire"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#RealizerDesire",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "realizer desire"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontodesire#Desire"
  }, {
    "@id" : "_:genid26"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A desire for an end that would count as one possible realization of an intrinsic desire — a realization relation, not a means-end relation."
  } ],
  "https://w3id.org/ontodesire#partitionedBy" : [ {
    "@id" : "https://w3id.org/ontodesire#byJustificatoryStructure"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#ReasonsAttention",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#CharacteristicMark"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "disposition to have attention drawn to reasons in favour of p"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#RewardLearningDrive",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontodesire#CharacteristicMark"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "use of representations of p to drive reward-based learning"
  } ]
}, {
  "@id" : "https://w3id.org/ontodesire#RewardLearningTheory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
