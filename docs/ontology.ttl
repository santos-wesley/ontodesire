###  https://w3id.org/ontodesire#noraDrinksTeaSoon
:noraDrinksTeaSoon rdf:type owl:NamedIndividual ,
                            :Proposition ;
                   rdfs:label "Nora drinks a cup of tea soon"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "The disambiguation among possessing/drinking and soon/someday is what motivates treating desires as propositional attitudes."@en .


###  https://w3id.org/ontodesire#noraTriesNewTeas
:noraTriesNewTeas rdf:type owl:NamedIndividual ,
                           :Proposition ;
                  rdfs:label "Nora tries teas she has not tried before"@en .


###  https://w3id.org/ontodesire#norasDesireForTea
:norasDesireForTea rdf:type owl:NamedIndividual ,
                            :FirstOrderDesire ,
                            :OccurrentDesire ,
                            :StateOfAffairsDesire ;
                   :hasBearer :Nora ;
                   :hasContent :noraDrinksTeaSoon ;
                   :hasStrength :norasTeaDesireStrength ;
                   :isSatisfiedBy :noraDrinksTeaSoon ;
                   rdfs:label "Nora's desire for tea"@en .


###  https://w3id.org/ontodesire#norasStandingDesireForNewTeas
:norasStandingDesireForNewTeas rdf:type owl:NamedIndividual ,
                                        :IntrinsicDesire ,
                                        :StandingDesire ;
                               :hasBearer :Nora ;
                               :hasContent :noraTriesNewTeas ;
                               rdfs:label "Nora's standing desire to try new teas"@en ;
                               <http://www.w3.org/2004/02/skos/core#note> "Example of the explanatory role of standing desires: explains why the new tin captures her attention and why she is delighted. No strength individual is asserted: under v0.3.0's max-1 axiom a desire need not carry a determinate cardinal strength."@en .


###  https://w3id.org/ontodesire#norasTeaDesireStrength
:norasTeaDesireStrength rdf:type owl:NamedIndividual ,
                                 :DesireStrength .


